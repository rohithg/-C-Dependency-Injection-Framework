relationship 'Sales order date'
	fromColumn: FactSales.DateKey
	toColumn: DimDate.DateKey

relationship 'Sales ship date'
	isActive: false
	fromColumn: FactSales.ShipDate
	toColumn: DimDate.Date

relationship 'Sales product'
	fromColumn: FactSales.ProductKey
	toColumn: DimProduct.ProductKey

relationship 'Sales store'
	fromColumn: FactSales.StoreKey
	toColumn: DimStore.StoreKey

relationship 'Sales customer'
	fromColumn: FactSales.CustomerKey
	toColumn: DimCustomer.CustomerKey

relationship 'Budget product'
	fromColumn: FactBudget.ProductKey
	toColumn: DimProduct.ProductKey

relationship 'Budget store'
	fromColumn: FactBudget.StoreKey
	toColumn: DimStore.StoreKey
