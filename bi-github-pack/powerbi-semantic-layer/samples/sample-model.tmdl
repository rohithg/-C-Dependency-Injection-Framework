table Measures
	lineageTag: 11111111-1111-1111-1111-111111111301

	measure 'Gross Sales' = SUM ( FactSales[ExtendedPrice] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales

	measure 'Net Sales' =
			VAR _gross =
			    CALCULATE (
			        [Gross Sales],
			        FactSales[DocType] = "Invoice"
			    )
			VAR _discounts =
			    CALCULATE (
			        SUM ( FactSales[DiscountAmount] ),
			        FactSales[DocType] = "Invoice"
			    )
			VAR _returns =
			    CALCULATE (
			        SUM ( FactSales[ExtendedPrice] ),
			        FactSales[DocType] IN { "Credit", "Allowance" }
			    )
			RETURN
			    _gross - _discounts - _returns
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation Description = "Certified. Gross - Discounts - Returns. Invoice date. See glossary."

	measure 'Net Sales (Ship Date)' =
			CALCULATE (
			    [Net Sales],
			    USERELATIONSHIP ( FactSales[ShipDateKey], DimDate[DateKey] )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales

	measure 'Gross Profit' = [Net Sales] - SUM ( FactSales[COGSAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Finance

	measure 'Gross Profit Margin %' = DIVIDE ( [Gross Profit], [Net Sales], BLANK () )
		formatString: 0.0%
		displayFolder: Finance

	measure 'AR Open Balance' =
			VAR _asOf = MAX ( DimDate[Date] )
			RETURN
			    CALCULATE (
			        SUM ( FactAR[AmountOpen] ),
			        FactAR[OpenFlag] = TRUE (),
			        FactAR[InvoiceDateKey] <= MAX ( DimDate[DateKey] ),
			        REMOVEFILTERS ( DimDate )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Finance

	measure 'AR Aging 61-90' =
			CALCULATE (
			    [AR Open Balance],
			    FactAR[AgingBucket] = "61-90"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Finance

	measure 'Net Sales YTD' = TOTALYTD ( [Net Sales], DimDate[Date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence

	measure 'Net Sales YoY %' =
			DIVIDE (
			    [Net Sales] - CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( DimDate[Date] ) ),
			    CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( DimDate[Date] ) ),
			    BLANK ()
			)
		formatString: 0.0%
		displayFolder: Time Intelligence

relationship Rel_FactSales_DimDate_Invoice
	fromColumn: FactSales.InvoiceDateKey
	toColumn: DimDate.DateKey
	joinOnDateBehavior: datePartOnly

relationship Rel_FactSales_DimDate_Ship
	fromColumn: FactSales.ShipDateKey
	toColumn: DimDate.DateKey
	isActive: false
	joinOnDateBehavior: datePartOnly

relationship Rel_FactSales_DimCustomer
	fromColumn: FactSales.CustomerKey
	toColumn: DimCustomer.CustomerKey

relationship Rel_FactSales_DimProduct
	fromColumn: FactSales.ProductKey
	toColumn: DimProduct.ProductKey

relationship Rel_FactSales_DimSalesRep
	fromColumn: FactSales.SalesRepKey
	toColumn: DimSalesRep.SalesRepKey

relationship Rel_FactAR_DimDate
	fromColumn: FactAR.InvoiceDateKey
	toColumn: DimDate.DateKey

relationship Rel_FactAR_DimCustomer
	fromColumn: FactAR.CustomerKey
	toColumn: DimCustomer.CustomerKey

relationship Rel_DimCustomer_DimRegion
	fromColumn: DimCustomer.RegionKey
	toColumn: DimRegion.RegionKey

relationship Rel_DimProduct_DimBusinessUnit
	fromColumn: DimProduct.BusinessUnitKey
	toColumn: DimBusinessUnit.BusinessUnitKey

relationship Rel_DimSalesRep_DimRegion
	fromColumn: DimSalesRep.RegionKey
	toColumn: DimRegion.RegionKey

table DimUserSecurity
	lineageTag: 11111111-1111-1111-1111-111111111107

	column UserEmail
		dataType: string
		sourceColumn: UserEmail

	column RegionCode
		dataType: string
		sourceColumn: RegionCode

	column BUCode
		dataType: string
		sourceColumn: BUCode

	column RoleType
		dataType: string
		sourceColumn: RoleType

	partition DimUserSecurity = m
		mode: import
		source = Sql.Database("sql-bi.contoso.local", "SemanticLayer"){[Schema="dbo",Item="DimUserSecurity"]}[Data]

role 'Region Manager'
	modelPermission: read

	tablePermission DimRegion =
			VAR _user = USERPRINCIPALNAME ()
			VAR _regions =
			    CALCULATETABLE (
			        VALUES ( DimUserSecurity[RegionCode] ),
			        DimUserSecurity[UserEmail] = _user,
			        DimUserSecurity[RoleType] IN { "Region", "Region+BU" },
			        DimUserSecurity[RegionCode] <> "*"
			    )
			VAR _seeAll =
			    CONTAINS (
			        CALCULATETABLE (
			            DimUserSecurity,
			            DimUserSecurity[UserEmail] = _user
			        ),
			        DimUserSecurity[RegionCode], "*"
			    )
			RETURN
			    _seeAll || DimRegion[RegionCode] IN _regions

role 'BU Controller'
	modelPermission: read

	tablePermission DimBusinessUnit =
			VAR _user = USERPRINCIPALNAME ()
			VAR _bus =
			    CALCULATETABLE (
			        VALUES ( DimUserSecurity[BUCode] ),
			        DimUserSecurity[UserEmail] = _user,
			        DimUserSecurity[RoleType] IN { "BU", "Region+BU" },
			        DimUserSecurity[BUCode] <> "*"
			    )
			VAR _seeAll =
			    CONTAINS (
			        CALCULATETABLE (
			            DimUserSecurity,
			            DimUserSecurity[UserEmail] = _user
			        ),
			        DimUserSecurity[BUCode], "*"
			    )
			RETURN
			    _seeAll || DimBusinessUnit[BUCode] IN _bus

annotation CompatibleVersions = "PowerBI:TMDL"
