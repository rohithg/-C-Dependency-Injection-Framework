/// Minimal tabular model sketch (TMDL-style) for the certified semantic layer.
/// Illustrative — not a full deployable model. Aligns with model/star-schema.md.

model SemanticLayer
	culture: en-US
	defaultMode: import
	discourageImplicitMeasures

	annotation PBI_QueryOrder = ["DimDate","DimRegion","DimBusinessUnit","DimCustomer","DimProduct","DimSalesRep","FactSales","FactAR"]
	annotation DB_VersionVersion = "2026.09.1"
	annotation CertificateStatus = "Certified"

