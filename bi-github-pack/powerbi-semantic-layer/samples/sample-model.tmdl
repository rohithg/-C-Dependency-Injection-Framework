	lineageTag: 11111111-1111-1111-1111-111111111101
	dataCategory: Time

	column DateKey
		dataType: int64
		isKey
		formatString: 0
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		formatString: Long Date
		sourceColumn: Date
		annotation Summarization = "None"

	column MonthStart
		dataType: dateTime
		sourceColumn: MonthStart

	column FiscalYear
		dataType: int64
		sourceColumn: FiscalYear

	column FiscalMonth
		dataType: int64
		sourceColumn: FiscalMonth

	partition DimDate = m
		mode: import
		source =
			let
			    Source = Sql.Database("sql-bi.contoso.local", "SemanticLayer"),
			    dbo_DimDate = Source{[Schema="dbo",Item="DimDate"]}[Data]
			in
			    dbo_DimDate

