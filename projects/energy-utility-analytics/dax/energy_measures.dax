// Certified energy / utility measures — Rohith Gangapuram portfolio
// Resume alignment: Nexant utility analytics · Amplytico energy clients

Total kWh :=
SUM ( FactEnergyUsage[kWh] )

Peak Demand kW :=
MAX ( FactEnergyUsage[PeakKW] )

Incentive Spend :=
SUM ( FactEnergyUsage[IncentivePaidUSD] )

Compliance Rate :=
DIVIDE (
    CALCULATE ( COUNTROWS ( FactEnergyUsage ), FactEnergyUsage[IsCompliant] = TRUE ),
    COUNTROWS ( FactEnergyUsage )
)

kWh YoY % :=
VAR Curr = [Total kWh]
VAR Prior = CALCULATE ( [Total kWh], SAMEPERIODLASTYEAR ( DimDate[FullDate] ) )
RETURN DIVIDE ( Curr - Prior, Prior )

Cost per kWh Saved :=
DIVIDE ( [Incentive Spend], [Total kWh] )

Participating Customers :=
SUM ( FactEnergyUsage[CustomerCount] )

Non Compliant Utilities :=
CALCULATE (
    DISTINCTCOUNT ( DimUtility[UtilityID] ),
    FactEnergyUsage[IsCompliant] = FALSE
)

// --- Additional time intelligence / program mix ---
Incentive Spend YTD :=
TOTALYTD ( [Incentive Spend], DimDate[FullDate] )

kWh vs Prior Month % :=
VAR Curr = [Total kWh]
VAR Prior = CALCULATE ( [Total kWh], DATEADD ( DimDate[FullDate], -1, MONTH ) )
RETURN DIVIDE ( Curr - Prior, Prior )

EE Share of kWh :=
DIVIDE (
    CALCULATE ( [Total kWh], DimProgram[ProgramFamily] = "EE" ),
    [Total kWh]
)

Avg Incentive per Customer :=
DIVIDE ( [Incentive Spend], [Participating Customers] )

Compliance Gap Utilities :=
CALCULATE (
    DISTINCTCOUNT ( DimUtility[UtilityID] ),
    [Compliance Rate] < 0.90
)
