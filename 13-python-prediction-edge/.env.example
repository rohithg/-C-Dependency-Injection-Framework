# Live trading stays off unless config live_enabled is true, you pass --live,
# and this phrase is set. Paper mode needs none of these.
EDGE_LIVE_OK=

# Kalshi. The private key stays in a file, not in this variable.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Polymarket CLOB. The bot uses this only to lift a YES+NO pair.
POLY_PRIVATE_KEY=
